import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/cmp",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs" @test_fs,
  "moonbitlang/core/async/process" @test_process,
} for "test"

options(
