    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/process",
  ],
  targets: {
    "ffi.mbt": [ "native" ],
    "local.mbt": [ "native" ],
    "local_test.mbt": [ "native" ],
    "local_wbtest.mbt": [ "native" ],
  },
)
