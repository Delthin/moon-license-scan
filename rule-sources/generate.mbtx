----
import {
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}
----

///|
fn source_string(s : String) -> String {
  Json::string(s).stringify()
}

///|
priv struct Selected {
  id : String
  expression : String
  kind : String
  path : String
  sha256 : String
  lines : Array[String]
  words : Array[String]
}

///|
fn normalized_words(text : String) -> Array[String] {
  let words = []
  let mut start = -1
  for i in 0..<text.length() {
    let c = text[i]
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
      if start < 0 {
        start = i
      }
    } else if start >= 0 {
      words.push(text[start:i].to_owned().to_lower())
      start = -1
    }
  }
  if start >= 0 {
    words.push(text[start:].to_owned().to_lower())
  }
  words
}

///|
fn anchor(
  sequence : Array[String],
  frequencies : Map[(String, String), Int32],
) -> Int32 {
  let mut offset = 0
  let mut rarest = 2147483647
  let mut longest = 0
  for i in 0..<(sequence.length() - 1) {
    let frequency = frequencies[(sequence[i], sequence[i + 1])]
    let length = sequence[i].length() + sequence[i + 1].length()
    if frequency < rarest || (frequency == rarest && length > longest) {
      rarest = frequency
      longest = length
      offset = i
    }
  }
  offset
}

///|
fn main raise {
  let args = @env.args()
  guard args is [_, upstream, selection] else {
    fail("usage: generate.mbtx SCANCODE_CHECKOUT SELECTION_TSV")
  }
  let revision = "abd87fb81609ea4a29ab4cdda755c188b8be3601"
  let paths = "src/licensedcode/data/"
  let origin = "https://github.com/aboutcode-org/scancode-toolkit/blob/\{revision}/"
  let rows = @fs.read_file_to_string(selection).split("\n").collect()
  let generated = StringBuilder()
  generated.write_string(
    "// Generated by rule-sources/generate.mbtx. Do not edit.\n// The rule data is derived from ScanCode v32.5.0 under CC BY 4.0; see NOTICE.\n\n///|\n/// Returns the embedded detection rules in their stable corpus order.\npub fn corpus() -> Array[RuleSource] {\n  [\n",
  )
  let selected : Array[Selected] = []
  let seen : Map[String, Unit] = Map([])
  for row in rows[1:] {
    if row.trim().is_empty() {
      continue
    }
    guard row.split("\t").collect()
      is [id_view, expression, kind, path, first, last, digest, reason] else {
      fail("invalid rule selection row: \{row}")
    }
    let id = id_view.to_owned()
    let valid_kind = match kind {
      "text" | "fragment" => !expression.is_empty()
      "ambiguous" => expression.is_empty()
      _ => false
    }
    guard !id.is_empty() &&
      valid_kind &&
      !reason.trim().is_empty() &&
      (path.has_prefix("rules/") || path.has_prefix("licenses/")) &&
      !path.contains("..") &&
      !seen.contains(id) else {
      fail("invalid or duplicate rule selection: \{id}")
    }
    seen[id] = ()
    let file = paths + path.to_owned()
    let bytes = @fs.read_file_to_bytes("\{upstream}/\{file}")
    let sha256 = @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
    guard sha256 == digest.to_owned() else {
      fail("unexpected upstream file digest for \{id}: \{sha256}")
    }
    let lines = @utf8.decode(bytes).split("\n").collect()
    let from = @string.parse_int(first.to_owned())
    let through = @string.parse_int(last.to_owned())
    guard from >= 1 &&
      through <= lines.length() &&
      from <= through &&
      !lines[from - 1].trim().is_empty() &&
      !lines[through - 1].trim().is_empty() else {
      fail("invalid source line range for \{id}: \{from}-\{through}")
    }
    let pattern = lines[from - 1:through].map(line => line.trim_end().to_owned())
    let words = normalized_words(pattern.join("\n"))
    guard words.length() >= 2 else {
      fail("rule must contain an adjacent word pair: \{id}")
    }
    selected.push({
      id,
      expression: expression.to_owned(),
      kind: kind.to_owned(),
      path: file,
      sha256,
      lines: pattern,
      words,
    })
  }
  guard !selected.is_empty() else { fail("selection has no rules") }
  let frequencies : Map[(String, String), Int32] = Map([])
  for entry in selected {
    for i in 0..<(entry.words.length() - 1) {
      let pair = (entry.words[i], entry.words[i + 1])
      frequencies[pair] = frequencies.get(pair).unwrap_or(0) + 1
    }
  }
  for entry in selected {
    let offset = anchor(entry.words, frequencies)
    generated.write_string(
      "    {\n      id: \{source_string(entry.id)},\n      expression: \{source_string(entry.expression)},\n      pattern: (\n",
    )
    for line in entry.lines {
      generated.write_string("        #|\{line}\n")
    }
    generated.write_string(
      "      ),\n      kind: \{source_string(entry.kind)},\n      source: \{source_string(origin + entry.path)},\n      sha256: \{source_string(entry.sha256)},\n      notice: None,\n      anchor: \{offset},\n    },\n",
    )
  }
  generated.write_string("  ]\n}")
  println(generated.to_string())
}
