----
import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/fs",
}
----

///|
fn table(text : String, header : String, count : Int, deprecated_count : Int) -> Array[(String, String, Bool)] raise {
  guard text.split_once(header) is Some((_, after)) &&
    after.split_once("\n];") is Some((body, _)) else {
    fail("missing fixed identifier table")
  }
  let values : Array[(String, String, Bool)] = []
  let mut previous = ""
  let mut deprecated_total = 0
  for line in body.split("\n") {
    let line = line.trim()
    if line.has_prefix("name: \"") && line.has_suffix("\",") {
      guard previous == "" else { fail("identifier without flags") }
      previous = line[7:line.length() - 2].to_owned()
    } else if line.has_prefix("flags: ") {
      guard previous != "" else { fail("flags without an identifier") }
      // The crate also carries seven aliases that are not SPDX 3.29.0 IDs.
      if previous != "NOASSERTION" &&
        !(previous.has_prefix("GFDL-") && previous.has_suffix("-invariants")) {
        let deprecated = line.contains("IS_DEPRECATED")
        if deprecated { deprecated_total += 1 }
        values.push((previous.to_lower(), previous, deprecated))
      }
      previous = ""
    }
  }
  guard previous == "" && values.length() == count && deprecated_total == deprecated_count else {
    fail("unexpected identifier count")
  }
  values.sort_by((a, b) => a.0.compare(b.0))
  for i in 1..<values.length() {
    guard values[i - 1].0 < values[i].0 else { fail("duplicate SPDX identifier") }
  }
  values
}

///|
fn emit(name : String, values : Array[(String, String, Bool)]) -> Unit {
  println("///|\nlet \{name} : ReadOnlyArray[(String, String, Bool)] = [")
  for entry in values {
    let (key, canonical, deprecated) = entry
    let k = Json(key).stringify()
    let value = Json(canonical).stringify()
    println("  (\{k}, \{value}, \{deprecated}),")
  }
  println("]")
}

///|
fn main raise {
  guard @env.args() is [_, file] else { fail("expected path to identifiers.rs") }
  let data = @fs.read_file_to_bytes(file)
  guard @crypto.bytes_to_hex_string(@crypto.sha256(data)) == "6e8592e4c7d6ea98813fa1ab31662a26461f08be2bf155453c5191fc1005d376" else {
    fail("unexpected identifiers.rs digest")
  }
  let text = @utf8.decode(data[:])
  let licenses = table(text, "pub const LICENSES: &[License] = &[", 740, 32)
  let exceptions = table(text, "pub const EXCEPTIONS: &[Exception] = &[", 86, 1)
  println("// SPDX License List 3.29.0, derived from EmbarkStudios/spdx 0.13.6 (Apache-2.0).\n// Generated by spdx-sources/generate.mbtx; retains IDs and deprecation flags only.\n")
  emit("licenses", licenses)
  println("")
  emit("exceptions", exceptions)
}
