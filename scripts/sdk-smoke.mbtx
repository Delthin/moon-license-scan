----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
}
----

///|
async fn main {
  let temp = @fs.tmpdir(prefix="moon-license-scan-sdk-")
  defer @fs.rmdir(temp, recursive=true)
  let target = temp + "/build"
  guard @process.run("moon", ["package", "--target-dir", target]) == 0 else {
    fail("Mooncakes package failed")
  }
  let publish = target + "/publish"
  let prefix = "Delthin-moon_license_scan-"
  guard @fs.readdir(publish) is [name] &&
    name.has_prefix(prefix) &&
    name.has_suffix(".zip") &&
    name.length() > prefix.length() + 4 else {
    fail("Expected exactly one new Mooncakes archive")
  }
  let version = name[prefix.length():name.length() - 4]
  let archive = publish + "/" + name
  let source = temp + "/source"
  @fs.mkdir(source)
  let status = match @async.platform {
    Windows => @process.run("tar.exe", ["-xf", archive, "-C", source])
    _ => @process.run("unzip", ["-q", archive, "-d", source])
  }
  guard status == 0 else { fail("SDK extraction failed") }
  @fs.mkdir(temp + "/consumer/src", recursive=true)
  let consumer = temp + "/consumer"
  @fs.write_file(
    consumer + "/moon.mod",
    (
      #|name = "smoke/independent"
      #|source = "src"
      #|preferred_target = "native"
    ) +
    "\nimport { \"Delthin/moon_license_scan@\{version}\" }\n",
    create_mode=CreateNew,
  )
  @fs.write_file(
    consumer + "/src/moon.pkg",
    (
      #|import { "Delthin/moon_license_scan" @scan }
      #|pkgtype(kind: "executable")
    ),
    create_mode=CreateNew,
  )
  @fs.write_file(
    consumer + "/src/main.mbt",
    (
      #|fn main {
      $|  guard @scan.VERSION == "\{version}" else { abort("SDK version does not match the archive") }
      #|  let report = @scan.Scanner::new().scan("example.c") catch { _ => abort("independent scan failed") }
      #|  guard report.files is [{findings: [{expression: "MIT", start_line: 1, ..}], ..}] else {
      #|    abort("expected MIT evidence at line 1")
      #|  }
      #|}
    ),
    create_mode=CreateNew,
  )
  @fs.write_file(
    consumer + "/example.c",
    "// SPDX-License-Identifier: MIT\n",
    create_mode=CreateNew,
  )
  guard @process.run("moon", ["work", "init", "consumer", "source"], cwd=temp) ==
    0 else {
    fail("Could not select the extracted SDK as the local dependency")
  }
  guard @process.run("moon", ["run", "--target", "native", "src"], cwd=consumer) ==
    0 else {
    fail("Independent SDK consumer failed")
  }
  let output = "_build/verified-sdk"
  @fs.mkdir(output, recursive=true, allow_exist=true)
  @fs.write_file(output + "/" + name, @fs.read_file(archive))
  println("PASS: independent native project verified \{name}")
}
